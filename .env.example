NODE_ENV=dev
PORT=3333
DATABASE_URL="postgresql://user:password@localhost:5432/klyro?schema=public"
# URL pública usada pelo Better Auth para validar a origem das requisições.
BETTER_AUTH_URL="http://localhost:3333"
# Segredo de pelo menos 32 caracteres para assinar as sessões.
BETTER_AUTH_SECRET=""
# Chave AES-256 do vault: 32 bytes em base64.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar essa chave torna todas as credenciais já salvas indecifráveis.
ENCRYPTION_KEY=""
